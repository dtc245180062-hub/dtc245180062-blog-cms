# Sao chép thành .env rồi điền, HOẶC chạy: ./scripts/gen-env.sh (tự sinh mật khẩu mạnh)
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Tài khoản Basic Auth cho phpMyAdmin (qua Nginx, cổng 9443)
PMA_BASIC_USER=admin
PMA_BASIC_PASSWORD=CHANGE_ME

# (Commit 2) Grafana + user giám sát MySQL
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
EXPORTER_DB_PASSWORD=CHANGE_ME
